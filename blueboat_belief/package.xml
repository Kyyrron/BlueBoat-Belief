<?xml version="1.0"?>
<package format="3">
  <name>blueboat_belief</name>
  <version>0.1.0</version>
  <description>BlueBoat-Belief (D4): recursive probabilistic belief map (coverage, aspect history, contacts) from processed side-scan pings and detections; publishes BeliefGrid for the replanner.</description>
  <maintainer email="killian.bertrand2002@gmail.com">Killian Bertrand</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>rcl_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>blueboat_interfaces</depend>
  <depend>blueboat_belief_interfaces</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>ros2bag</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
